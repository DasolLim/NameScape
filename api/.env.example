# Copy to api/.env and fill in for a real deployment.
# `make dev` sets the development values itself; this file is for production.

# --- Mail -------------------------------------------------------------------
# Without SMTP_HOST no mail is sent and the sign-in link is only logged, which
# means nobody can sign in. This is the single most important thing to set.
#
# Gmail:    smtp.gmail.com / 587 / an App Password, not your account password
# Resend:   smtp.resend.com / 587 / "resend" / your API key
# Mailgun:  smtp.mailgun.org / 587 / postmaster@your-domain / your password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=true
SMTP_FROM=Toponomicon <no-reply@your-domain>

# Where the emailed sign-in link should point.
APP_BASE_URL=https://your-domain

# --- Security ---------------------------------------------------------------
# Signs session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Moderation calls Claude Haiku and fails closed without a key, so every
# caption and nickname is rejected until this is set.
ANTHROPIC_API_KEY=

# MUST stay false in production: it turns the fail-closed moderation pipeline
# into a fail-open one.
MODERATION_DEV_BYPASS=false

# --- Services ---------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/toponomicon
REDIS_URL=redis://host:6379/0
SENTRY_DSN=
