# Copy to api/.env and fill in for a real deployment.
# `make dev` sets the development values itself; this file is for production.

# --- Mail -------------------------------------------------------------------
# Without SMTP_HOST no mail is sent and the sign-in link is only logged, which
# means nobody can sign in. This is the single most important thing to set.
#
# Gmail:    smtp.gmail.com / 587 / an App Password, not your account password
# Resend:   smtp.resend.com / 587 / "resend" / your API key
# Mailgun:  smtp.mailgun.org / 587 / postmaster@your-domain / your password
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_START_TLS=true
SMTP_FROM=NameScape <no-reply@your-domain>

# Where the emailed sign-in link should point.
APP_BASE_URL=https://your-domain

# --- Security ---------------------------------------------------------------
# Signs session cookies. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# MUST stay false in production: it turns the fail-closed moderation pipeline
# into a fail-open one.
MODERATION_DEV_BYPASS=false

# --- Services ---------------------------------------------------------------
# Postgres must have PostGIS and pg_trgm available: the schema uses geography
# columns and search relies on trigram indexes. Migration 0001 creates both, so
# the role needs CREATE EXTENSION. Supabase and Neon both qualify.
# On a pooled connection (Supabase transaction mode, port 6543) prepared
# statements are unavailable, which app/db.py accounts for.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/namescape

# Migrations need prepared statements, so they use a session or direct
# connection rather than the transaction pooler.
DATABASE_URL_DIRECT=postgresql+asyncpg://user:password@host:5432/namescape

# Every write returns 503 without Redis, deliberately: an uncounted write is
# worse than a refused one. Must be the Redis TCP endpoint (rediss://), not a
# provider's REST URL.
REDIS_URL=redis://host:6379/0
SENTRY_DSN=

# Claims allowed per address per day without an account (default 3). A guest
# claim locks a place for a week and costs nothing to make.
GUEST_CLAIMS_PER_DAY=3

# OpenRouter covers every model call in the product.
#
# Moderation is the one in a request path, and it FAILS CLOSED: without this
# key every caption, nickname and correction is rejected. It is the single
# most important setting after the database.
#
# The other two callers are offline and degrade gracefully: puzzle clue
# drafting refuses to run, and etymology stops at its three citable tiers.
#
# Confirm any slug against OpenRouter's model list before relying on it.
OPENROUTER_API_KEY=
# Offline work. Volume is a few hundred calls a year, so a strong model costs
# pennies more than a cheap one.
OPENROUTER_MODEL=openai/gpt-5-mini
# Moderation. Wants speed, since somebody is waiting on a button press, but
# this decides whether real people's text is refused: not the cheapest option.
MODERATION_MODEL=openai/gpt-5-mini
